# ===============================================================
#  GitHub 에 절대 올라가면 안 되는 것들
#
#  공개 저장소라면 한 번 올라간 열쇠는 지워도 커밋 기록에 남습니다. 조심하세요.
#
#  ※ 주의: .gitignore 에서 # 주석은 '줄 맨 앞'에만 쓸 수 있습니다.
#     data/   # 설명   ← 이렇게 쓰면 뒤의 글자까지 통째로 규칙이 되어 동작하지 않습니다.
#     그래서 아래는 설명을 전부 위쪽 줄에 따로 적었습니다.
# ===============================================================

# --- 열쇠 · 비밀값 ------------------------------------------------
.env
.env.*
.streamlit/secrets.toml
secrets.toml
*.pem
*.key
service_account*.json
credentials*.json

# 값이 비어 있는 견본은 올려야 하므로 위 .env.* 규칙에서 빼줍니다.
!.env.example

# --- 사용자 데이터 · 로컬 로그 --------------------------------------
# data/ 는 Supabase 가 안 될 때만 쓰는 로컬 폴백 저장소입니다.
# (events.csv · feedback.csv · cards.json — 실제 사용자 기록이 들어갑니다)
data/
*.log
logs/

# --- 파이썬 ------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- 에디터 · 운영체제 ---------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
