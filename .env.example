# 할매 앱 환경변수 견본
#
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 .gitignore 에 있어 커밋되지 않습니다)
#     cp .env.example .env
#
# 터미널에서 한 번에 불러오려면:
#     set -a && source .env && set +a
#     streamlit run app.py
#
# Streamlit Community Cloud 에 올릴 때는 파일 대신
# Settings → Secrets 에 같은 이름으로 넣으면 됩니다.

# --- Gemini -----------------------------------------------------
GEMINI_API_KEY=

# --- Supabase ---------------------------------------------------
# Dashboard → Project Settings → API 에서 복사합니다.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# 서버에서만 쓰는 비밀 열쇠(service_role). 브라우저에 절대 노출하지 마세요.
SUPABASE_SECRET_KEY=

# 브라우저에 노출되어도 되는 열쇠(anon). 이 앱은 서버에서 저장하므로 쓰지 않습니다.
# SUPABASE_PUBLISHABLE_KEY=

# --- 저장소 고르기 (선택) ----------------------------------------
#   auto      (기본값) 위 두 값이 있으면 Supabase, 없으면 로컬 파일
#   supabase  무조건 Supabase
#   local     무조건 로컬 파일 (data/*.csv · data/cards.json) — 개발용
# HALMAE_STORAGE=auto

# --- 개발자 Funnel 화면 열기 -------------------------------------
# 이 값을 정해두어야 http://.../?dev=<이 값> 으로 지표 화면이 열립니다.
# 비워두면 어떤 주소로도 열리지 않습니다. (배포 기본값 — 그대로 두는 것이 안전합니다)
# 8자 이상, 1 / dev / test 처럼 뻔한 값은 인정하지 않습니다.
# HALMAE_DEV_KEY=

# --- 개발자용 화면(프롬프트·Debug) 보이기 --------------------------
# 배포에서는 절대 넣지 마세요. 넣으면 Gemini 프롬프트·응답 원문·좌표가 화면에 보입니다.
# HALMAE_USE_DEV_MODE=false
